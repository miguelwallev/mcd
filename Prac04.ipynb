  "cells": [
    {
      "cell_type": "markdown",
      "source": [
        "# Práctica de Simulación\n",
        "\n",
        "Este código permite a los estudiantes simular un presupuesto de enlace óptico de alta capacidad y calcular el **OSNR** resultante, fundamental para determinar si un formato de modulación (como 16-QAM) es viable sobre una distancia dada."
      ],
      "metadata": {
        "id": "ZZm2GmIW0TTf"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# =============================================================================\n",
        "# PRÁCTICA: Diseño de Presupuesto de Enlace Óptico y OSNR\n",
        "# Asignatura: Medios y Comunicaciones Digitales\n",
        "# =============================================================================\n",
        "\n",
{
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "def calcular_enlace_optico(distancia_km, p_tx_dbm, ganancia_edfa_db, nf_edfa_db):\n",
        "    # 1. Parámetros de la Fibra (SMF G.652)\n",
        "    atenuacion_por_km = 0.22  # dB/km\n",
        "    perdida_conector = 0.5    # dB por conector\n",
        "    perdida_empalme = 0.1     # dB por empalme (cada 2km)\n",
        "\n",
        "    # 2. Cálculo de Pérdidas Totales\n",
        "    num_empalmes = distancia_km // 2\n",
        "    l_fibra = atenuacion_por_km * distancia_km\n",
        "    l_total = l_fibra + (2 * perdida_conector) + (num_empalmes * perdida_empalme)\n",
        "\n",
        "    # 3. Potencia al final del tramo (sin amplificar)\n",
        "    p_rx_pre_amp = p_tx_dbm - l_total\n",
        "\n",
        "    # 4. Potencia después del amplificador (EDFA)\n",
        "    p_rx_final = p_rx_pre_amp + ganancia_edfa_db\n",
        "\n",
        "    # 5. Cálculo de OSNR (Simplificado)\n",
        "    # OSNR = P_signal(dBm) - Noise_Floor(dBm)\n",
        "    # Noise Floor = -58 + NF + Gain - Span_Loss (Aprox. para Banda C)\n",
        "    osnr = 58 + p_tx_dbm - l_total - nf_edfa_db\n",
        "\n",
        "    return p_rx_pre_amp, p_rx_final, osnr\n",
        "\n",
        "# --- Escenario de Simulación ---\n",
        "distancias = np.arange(10, 101, 10) # Enlaces de 10 a 100 km\n",
        "p_tx = 0.0 # Potencia de transmisión en dBm\n",
        "ganancia = 20.0 # Ganancia del amplificador EDFA\n",
        "nf = 6.0 # Figura de ruido del amplificador\n",
        "\n",
        "resultados_osnr = []\n",
        "for d in distancias:\n",
        "    _, _, osnr_val = calcular_enlace_optico(d, p_tx, ganancia, nf)\n",
        "    resultados_osnr.append(osnr_val)\n",
        "\n",
        "# --- Visualización ---\n",
        "plt.figure(figsize=(10, 6))\n",
        "plt.plot(distancias, resultados_osnr, 's-', color='teal', label='OSNR Calculado')\n",
        "plt.axhline(y=18, color='red', linestyle='--', label='Umbral 16-QAM (18 dB)')\n",
        "plt.axhline(y=12, color='orange', linestyle='--', label='Umbral QPSK (12 dB)')\n",
        "\n",
        "plt.title(\"Calidad del Enlace Óptico vs Distancia\")\n",
        "plt.xlabel(\"Distancia del Enlace (km)\")\n",
        "plt.ylabel(\"OSNR (dB)\")\n",
        "plt.legend()\n",
        "plt.grid(alpha=0.3)\n",
        "plt.show()\n",
        "\n",
        "print(f\"OSNR a 80km: {resultados_osnr[7]:.2f} dB\")",
      ],
      "outputs": [],
      "execution_count": null,
